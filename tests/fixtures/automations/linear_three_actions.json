{
  "name": "linear_three_actions",
  "status": "active",
  "nodes": [
    {
      "node_key": "trigger",
      "kind": "trigger",
      "type": "trigger.object_created",
      "label": "Contact created",
      "position_x": 0,
      "position_y": 0,
      "config": { "objectType": "contact" }
    },
    {
      "node_key": "update_one",
      "kind": "action",
      "type": "action.update_object",
      "label": "Set first name",
      "position_x": 200,
      "position_y": 0,
      "config": {
        "objectType": "contact",
        "targetRecord": { "mode": "trigger_subject" },
        "updates": [
          {
            "property": "first_name",
            "value": { "kind": "static", "value": "LinearOne" }
          }
        ]
      }
    },
    {
      "node_key": "email",
      "kind": "action",
      "type": "action.send_email",
      "label": "Send email",
      "position_x": 400,
      "position_y": 0,
      "config": {
        "to": { "kind": "dynamic", "expression": "{{trigger.attributes.email}}" },
        "subject": { "kind": "static", "value": "Linear hello" },
        "bodyType": "custom",
        "body": { "kind": "static", "value": "Linear body" }
      }
    },
    {
      "node_key": "update_two",
      "kind": "action",
      "type": "action.update_object",
      "label": "Set last name",
      "position_x": 600,
      "position_y": 0,
      "config": {
        "objectType": "contact",
        "targetRecord": { "mode": "trigger_subject" },
        "updates": [
          {
            "property": "last_name",
            "value": { "kind": "static", "value": "LinearTwo" }
          }
        ]
      }
    }
  ],
  "edges": [
    {
      "source_node_id": "trigger",
      "target_node_id": "update_one",
      "source_handle": "default",
      "condition": { "type": "always" }
    },
    {
      "source_node_id": "update_one",
      "target_node_id": "email",
      "source_handle": "default",
      "condition": { "type": "always" }
    },
    {
      "source_node_id": "email",
      "target_node_id": "update_two",
      "source_handle": "default",
      "condition": { "type": "always" }
    }
  ],
  "_harness": {}
}
